# alison-plugin — global ignore list (git config core.excludesFile).
# Files matching these names never enter ANY repository on this machine,
# even with `git add .`. Installed by /alison-plugin:comecar.
# Two families: what must not leak (secrets) and what nobody needs (generated).

# --- Secrets — every spelling. The documented templates stay visible.
.env
.env.*
*.env
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
credentials.json
service-account*.json
.netrc
.htpasswd
.aws/credentials

# --- Dependencies: reinstalled from package.json / lockfile, never uploaded.
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
bower_components/
jspm_packages/
vendor/bundle/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
Pods/

# --- Build output and framework caches: regenerated by every build/deploy.
.next/
.nuxt/
.svelte-kit/
.output/
.vercel/
.netlify/
.turbo/
.parcel-cache/
.vite/
.angular/
dist/
build/
out/
coverage/
storybook-static/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.gradle/
target/

# --- Supabase local stack
supabase/.temp/
supabase/.branches/

# --- Logs, dumps, temporary and lock leftovers
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.dump
*.sql.gz
*.tmp
*.temp
*.swp
*.swo
*~
tmp/
temp/
.tmp/

# --- Operating system and editor leftovers
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace

# --- Claude Code local state (personal, never shared)
.claude/settings.local.json
.claude/scratchpad/
